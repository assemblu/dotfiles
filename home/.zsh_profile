export XDG_CONFIG_HOME=$HOME/.config
export VIM="nvim"
export EDITOR="nvim"
export GIT_EDITOR=$VIM

if command -v nvim >/dev/null 2>&1; then
  nvim_bin="$(readlink -f "$(command -v nvim)" 2>/dev/null || command -v nvim)"
  nvim_prefix="$(dirname "$(dirname "$nvim_bin")")"
  candidate="$nvim_prefix/share/nvim/runtime"
  [ -d "$candidate" ] && export VIMRUNTIME="$candidate"
fi

addToPath() {
    if [[ "$PATH" != *"$1"* ]]; then
        export PATH=$PATH:$1
    fi
}
addToPathFront() {
    if [[ "$PATH" != *"$1"* ]]; then
        export PATH=$1:$PATH
    fi
}

addToPathFront $HOME/.local/bin
addToPathFront $HOME/.local/scripts

addToPathFront "/opt/nvim-linux-x86_64/bin"

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

bindkey -s ^f "tmux-sessionizer\n"

alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

catr() {
    tail -n "+$1" $3 | head -n "$(($2 - $1 + 1))"
}

cat1Line() {
    cat $1 | tr -d "\n"
}
